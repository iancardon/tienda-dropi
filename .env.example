###############################################################################
# Ejemplo de variables de entorno. COPIA ESTE ARCHIVO a `.env` y cambia los
# valores. `.env` está en .gitignore: nunca lo subas al repositorio.
#
#   cp .env.example .env
#
# Este archivo SÍ se sube a Git, así que aquí solo van valores FALSOS.
# Para generar un ADMIN_SECRET:  npm run secret:admin
###############################################################################

# ----------------------------------------------------------------------------
# Base de datos (obligatoria)
# ----------------------------------------------------------------------------
# La app usa Prisma y solo necesita DATABASE_URL.
# Local con Postgres:
DATABASE_URL="postgresql://usuario:password@localhost:5432/tienda?schema=public"
#
# Supabase en producción (Vercel). Usa el POOLER, no la conexión directa, para
# no agotar el límite de conexiones del plan gratuito. Añade
# `?pgbouncer=true&connection_limit=1` al usar el modo transacción (puerto 6543).
#
#   postgresql://usuario:password@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
#
# Las migraciones se ejecutan aparte, con sesión (puerto 5432) o conexión
# directa. Ver la sección "Despliegue en Vercel" del README.
#
# La app usa el pooler (arriba). Las migraciones y Prisma Studio usan
# DIRECT_URL, porque el pooler en modo transacción no sirve para DDL. Puedes
# apuntar a la conexión directa de Supabase o al pooler en modo sesión.
DIRECT_URL="postgresql://usuario:password@localhost:5432/tienda?schema=public"

# ----------------------------------------------------------------------------
# Rate limit compartido (opcional pero recomendado en Vercel)
# ----------------------------------------------------------------------------
# Sin estas dos variables el limitador de peticiones funciona en memoria, y en
# Vercel eso significa un contador por instancia. Con ellas, el límite es el
# mismo para todas las instancias. Se crean gratis en upstash.com.
# UPSTASH_REDIS_REST_URL=https://mi-upstash.upstash.io
# UPSTASH_REDIS_REST_TOKEN=token-de-upstash-aqui

# ----------------------------------------------------------------------------
# Panel de administración (obligatorias en producción)
# ----------------------------------------------------------------------------
# Si ADMIN_PASSWORD o ADMIN_SECRET faltan, están vacías, son muy cortas o
# conservan un valor de ejemplo, la app NO arranca y lo dice por pantalla.
ADMIN_USER=admin
# Mínimo 8 caracteres. Cámbiala por una tuya.
ADMIN_PASSWORD=cambia-esta-contrasena
# Firma las cookies de sesión del panel. Mínimo 24 caracteres.
# Genera una con:  npm run secret:admin
ADMIN_SECRET=cambia-esta-clave-en-produccion

# ----------------------------------------------------------------------------
# Identidad de la tienda
# ----------------------------------------------------------------------------
# Nombre de la marca. Se usa en el header, el footer, el título de página, los
# metadatos (SEO) y los mensajes de WhatsApp.
# OJO: al ser NEXT_PUBLIC_ queda incrustado en el bundle del navegador. Si lo
# cambias tienes que RECOMPILAR (`npm run build`) y volver a arrancar.
NEXT_PUBLIC_STORE_NAME=MiTienda

# URL pública del sitio, sin barra final. Se usa en el sitemap, robots y SEO.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ----------------------------------------------------------------------------
# Datos de contacto (opcionales; aparecen en /contacto y en los mensajes)
# ----------------------------------------------------------------------------
STORE_TAGLINE=Paga cuando recibes
# Solo dígitos con código de país, sin + ni espacios: 573001234567
STORE_WHATSAPP=573000000000
STORE_EMAIL=contacto@mitienda.com
STORE_PHONE=+57 300 000 0000
STORE_ADDRESS=Colombia
# Titular del tratamiento de datos (persona o empresa responsable).
STORE_RESPONSIBLE=MiTienda (Titular por definir)

# ----------------------------------------------------------------------------
# Envío
# ----------------------------------------------------------------------------
# Costo de envío fijo en COP, cobrado en el checkout.
SHIPPING_COST=15000

# ----------------------------------------------------------------------------
# Hosts de imágenes externas (opcional)
# ----------------------------------------------------------------------------
# Dominios desde los que la tienda puede descargar y optimizar fotos de producto.
# Ya vienen de serie los de los productos de ejemplo (Unsplash y Picsum).
# Cuando cargues fotos reales de Dropi o de tu proveedor, añade aquí su
# dominio, separado por comas, y vuelve a desplegar. Ejemplo:
# IMAGE_HOSTS=cdn.dropi.com,images.miprops.com
# Sin esto, next/image rechaza las fotos de esos dominios y sale el marco
# "Sin imagen" en lugar de la foto.
# OJO: solo https, sin el https:// delante y sin rutas.
# IMAGE_HOSTS=

# ----------------------------------------------------------------------------
# Imágenes subidas desde el panel
# ----------------------------------------------------------------------------
# Dónde se guardan. En local basta la carpeta `uploads/` (ya está en
# .gitignore). OJO: en Vercel el disco es de solo lectura, así que subir
# imágenes NO funciona con esta variable; necesitas un bucket externo
# (Vercel Blob, S3 o Supabase Storage). Ver el README.
# UPLOADS_DIR=uploads

# ----------------------------------------------------------------------------
# Aviso por correo de pedido nuevo (opcional; requiere Resend)
# ----------------------------------------------------------------------------
# Sin estas variables la tienda NO manda ningún correo y todo funciona igual.
# Se crea una API key en resend.com. Es un secreto: nunca lo subas al repositorio.
# RESEND_API_KEY=re_tu_clave_aqui
#
# Correo que RECIBE el aviso de cada pedido nuevo.
# ORDER_NOTIFY_EMAIL=pedidos@mitienda.com
#
# Remitente. Por defecto onboarding@resend.dev, que es el único remitente que
# Resend acepta sin configurar un dominio propio. Si más adelante configuras
# tu dominio, pon aquí algo como ORDER_EMAIL_FROM=notificaciones@mitienda.com
# ORDER_EMAIL_FROM=onboarding@resend.dev
#
# Ponlo en true solo mientras Haz pruebas de pedidos marcados como prueba.
# Mientras esté en false (o ausente), los pedidos de prueba NO generan correo.
# ORDER_EMAIL_TEST=false

# ----------------------------------------------------------------------------
# Redes sociales (opcionales; vacío o ausente = no se muestran)
# ----------------------------------------------------------------------------
# Handle sin @ o URL completa.
SOCIAL_INSTAGRAM=
SOCIAL_FACEBOOK=
SOCIAL_TIKTOK=

# ----------------------------------------------------------------------------
# Solo para desarrollo, NO hace falta en Vercel
# ----------------------------------------------------------------------------
# 1 = `npm run db:seed` deja los productos de ejemplo visibles.
# OJO: el seed BORRA pedidos, productos y carritos antes de recrearlos.
SEED_DEMO_ACTIVE=0

# NODE_ENV lo pone el propio Next.js. No lo definas a mano.
